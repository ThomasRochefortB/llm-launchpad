/* ==========================================================
   llm-launchpad Textual theme
   Modal-inspired: deep black surfaces, vivid green accents,
   restrained chrome, and high-contrast content areas.
   ========================================================== */

/* ---- Global ---- */

* {
    scrollbar-background: $scrollbar-background;
    scrollbar-color: $scrollbar;
    scrollbar-background-hover: $scrollbar-background-hover;
    scrollbar-color-hover: $scrollbar-hover;
    scrollbar-background-active: $scrollbar-background-active;
    scrollbar-color-active: $scrollbar-active;
    scrollbar-size: 1 1;
}

/* A stable gutter belongs only on containers whose content genuinely grows and
   shrinks, where a scrollbar appearing mid-update would otherwise reflow the
   text beside it. Applying it to `*` taxed every widget one row and one column
   whether or not it could ever scroll: a three-option OptionList occupied six
   rows instead of five, every bordered panel showed a dead column inside its
   right edge, and `DataTable { min-height: 3 }` was left with zero content rows
   -- the Storage inventory rendered neither its models nor its header at 80x24.
   The Footer needed a hand-written exemption for the same reason. */
VerticalScroll,
LogViewer Log {
    scrollbar-gutter: stable;
}

Screen {
    background: $background;
    color: $text;
}

Vertical,
VerticalScroll,
OptionList,
DataTable,
SelectionList,
ListView {
    scrollbar-background: $scrollbar-background;
    scrollbar-color: $scrollbar;
    scrollbar-background-hover: $scrollbar-background-hover;
    scrollbar-color-hover: $scrollbar-hover;
    scrollbar-background-active: $scrollbar-background-active;
    scrollbar-color-active: $scrollbar-active;
}

/* ---- Footer ---- */

Footer {
    height: 2;
    background: $footer-background;
    color: $footer-foreground;
    border-top: solid $foreground 15%;
    /* Restore Textual's own footer scrollbar settings, which the global `*`
       rule above overrides. The border leaves exactly one content row, and a
       horizontal scrollbar would spend it; a reserved gutter collapses every
       auto grid column to zero width and blanks the whole row. */
    scrollbar-gutter: auto;
    scrollbar-size: 0 0;
}

/* ---- Status header widget ---- */

StatusHeader {
    /* One content row plus the bottom border. The widget renders a single
       line; the extra row this used to reserve was always blank. */
    height: 2;
    padding: 0 2;
    background: $surface;
    border-bottom: solid $foreground 15%;
}

/* ---- Log viewer ---- */

LogViewer {
    height: 1fr;
    border: round $foreground 20%;
    background: $surface;
    padding: 0 1;
}

LogViewer Log {
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

/* ---- Main menu ---- */

#main-menu-center {
    height: 1fr;
}

#compact-menu-header,
#compact-menu-help {
    display: none;
}

#main-menu-primary {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    content-align: center middle;
    align: center middle;
}

.screen-scroll {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

#main-menu-layout {
    width: 100%;
    max-width: 126;
    height: 1fr;
    max-height: 100%;
}

#main-menu-side-column {
    width: 56;
    min-width: 42;
    height: 1fr;
    max-height: 100%;
    margin: 1 0 0 1;
    overflow-y: auto;
    /* The menu beside it is centred; content-sized panels pinned to the top
       left the two columns visibly out of step. */
    align-vertical: middle;
}

/* Sized to its content: stretched to the column height, one "no endpoints"
   line sat in a thirty-row empty box. The side column scrolls instead when a
   long fleet outgrows it, so no entry is clipped mid-endpoint. */
#deployment-status-panel {
    width: 100%;
    height: auto;
    min-height: 3;
    overflow-y: auto;
    padding: 0 2;
    border: round $foreground 20%;
    background: $panel;
}

#billing-report-panel {
    width: 100%;
    height: auto;
    max-height: 50%;
    overflow-y: auto;
    margin: 1 0 0 0;
    padding: 0 2;
    border: round $foreground 20%;
    background: $panel;
}

#deployment-status-panel,
#billing-report-panel {
    border-title-color: $primary;
    border-title-style: bold;
}

#deployment-status-body {
    color: $text;
    text-wrap: wrap;
    overflow-y: auto;
}

#billing-report-body {
    color: $text;
    text-wrap: wrap;
}

#banner-text {
    text-align: center;
    color: $primary;
    padding: 0;
}

/* Compact fleet line under the menu. It stands in for the Deployment Status
   panel, so it shows only where that panel is hidden; beside the panel it
   repeated it. */
.viewport-narrow #fleet-summary-line,
.viewport-short #fleet-summary-line {
    display: block;
}

#fleet-summary-line {
    display: none;
    width: 100%;
    height: auto;
    padding: 1 1 0 1;
    text-wrap: wrap;
    color: $text;
}

#auth-status-block {
    width: auto;
    max-width: 92;
    height: auto;
    margin: 0 0 1 1;
    padding: 0 1;
    border-left: tall $foreground-muted;
    color: $text-muted;
    background: transparent;
}

/* ---- Option / Selection Lists ---- */

OptionList {
    background: $surface;
    border: round $foreground 20%;
    padding: 0;
    height: auto;
    max-height: 20;
}

OptionList:focus {
    border: round $primary;
}

OptionList > .option-list--option-highlighted {
    background: $primary 15%;
    color: $text;
    text-style: bold;
}

OptionList > .option-list--option-hover-highlighted {
    background: $primary 15%;
    color: $text;
    text-style: bold;
}

DataTable {
    background: $surface;
    border: round $foreground 20%;
    height: 1fr;
    /* Two rows go to the border, so a floor of 3 left a single content row for
       the header and none for the data. A table that shows no rows is worse
       than one that pushes its neighbours into a scroll, so the floor is the
       header plus three rows. */
    min-height: 6;
    max-height: 20;
    color: $text;
}

DataTable:focus {
    border: round $primary;
}

SelectionList {
    background: $surface;
    height: auto;
    max-height: 20;
}

ListView {
    background: $surface;
    height: auto;
    max-height: 20;
}

ListView > ListItem.--highlight {
    background: $primary 15%;
}

/* ---- Inputs ---- */

Input {
    border: tall $foreground 25%;
    background: $surface;
    color: $text;
    padding: 0 1;
}

Input.-invalid {
    border: tall $error;
}

/* A field a refused deploy pointed at (see _DeployFormFeedbackMixin). Not
   `-invalid`: Textual owns that class and clears it on its own validation. */
Input.-rejected,
Select.-rejected > SelectCurrent,
Input.-rejected:focus,
Select.-rejected:focus > SelectCurrent {
    border: tall $error;
}

Input:focus {
    border: tall $primary;
    background: $surface-lighten-1;
}

/* Textual's Select already draws a border around its value row (SelectCurrent).
   Bordering the Select itself nests one box inside another, so the border is
   styled where the widget actually draws it. */
Select {
    border: none;
    background: $surface;
    color: $text;
}

/* Neutral chrome for unfocused controls; only the focused control earns the
   primary border, so keyboard input always has exactly one bright target. */
Button:focus,
Select:focus > SelectCurrent {
    background: $primary 15%;
}

Select > SelectCurrent {
    border: tall $foreground 25%;
}

Select:focus > SelectCurrent {
    border: tall $primary;
    background: $surface-lighten-1;
}

OptionList > .option-list--option-highlighted {
    background: $primary 15%;
    color: $text;
    text-style: bold;
}

OptionList:focus > .option-list--option-highlighted {
    background: $primary 30%;
    color: $text;
    text-style: bold;
}

DataTable:focus > .datatable--header {
    color: $primary;
    text-style: bold;
}

DataTable:focus > .datatable--cursor {
    background: $primary 30%;
    color: $text;
    text-style: bold;
}

/* `variant="error"` adds `-error`; this rule used to target `-danger`, which
   nothing sets, so destructive buttons looked like every other button. */
Button.-error {
    border: round $error;
    color: $error;
    text-style: bold;
}

Button.-error:hover,
Button.-error:focus {
    background: $error;
    color: $background;
    border: round $error;
}

.dialog-scroll {
    align: center middle;
}

.dialog-panel {
    width: 100%;
    max-width: 76;
    height: auto;
    padding: 1 2;
    border: round $foreground 20%;
    background: $surface;
}

.dialog-title {
    color: $primary;
    text-style: bold;
}

.dialog-actions {
    width: 100%;
    height: auto;
    margin-top: 1;
    align: left middle;
}

.dialog-actions Button {
    margin: 0 1 0 0;
}

Switch {
    background: $surface;
}

Switch > .switch--slider {
    color: $background;
    background: $foreground-muted;
}

Switch.-on > .switch--slider {
    background: $primary;
}

/* ---- Buttons ---- */

Button {
    min-width: 16;
    background: $panel;
    color: $text;
    border: round $foreground 30%;
}

Button:hover {
    background: $primary 15%;
    border: round $primary;
}

Button.-primary {
    background: $primary;
    color: $button-color-foreground;
    text-style: bold;
    border: round $primary;
}

/* One focus treatment for every control: the primary border that Input,
   Select, OptionList and DataTable also use. `$accent` drew a yellow ring in
   High Contrast that no other control shared. */
Button:focus {
    text-style: bold;
    border: round $primary;
}

/* A primary button is already filled and bordered in the primary colour, so
   focus shows as a light ring instead. */
Button.-primary:focus {
    border: round $foreground;
}

/* ---- Fast deploy flow ---- */

#fast-deploy-container {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

#fast-deploy-title {
    height: auto;
}

#fast-deploy-subtitle,
#fast-deploy-status {
    color: $text-muted;
    height: auto;
    padding: 0 0 1 0;
}

#fast-deploy-gpu-label,
#fast-deploy-search-label {
    color: $text-muted;
    height: 1;
    padding: 0;
    margin: 0;
}

#fast-deploy-filter-row {
    width: 100%;
    height: auto;
}

/* The group owns the width so the Select can simply fill it; the narrow
   override below then stretches both together. */
#fast-deploy-search-group {
    width: 1fr;
    max-width: 72;
    height: auto;
    margin: 0 2 1 0;
}

/* The GPU filter narrows the list; search finds the model. Search takes what
   the filter does not, and the filter keeps a readable floor. */
#fast-deploy-gpu-group {
    width: 30;
    min-width: 24;
    height: auto;
    margin: 0 0 1 0;
}

#fast-deploy-gpu-filter {
    width: 100%;
    /* Select draws its own bordered value row; pinning the outer height
       squeezes that border into the line the value should occupy. */
    height: auto;
    margin: 0;
    padding: 0;
}

#fast-deploy-model-search {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0;
    padding: 0;
}

#fast-deploy-list {
    width: 100%;
    height: 1fr;
    max-height: 24;
    text-wrap: nowrap;
}

#fast-deploy-list > .option-list--option {
    text-wrap: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
}

#fast-deploy-detail {
    width: 100%;
    height: auto;
    min-height: 3;
    margin: 1 0 0 0;
    padding: 0 1;
    border-left: tall $primary;
    background: $surface-lighten-1;
    text-wrap: wrap;
}

/* ---- Quick deploy screen ---- */

#quick-deploy-title {
    padding: 1 2 0 2;
}

/* The decision facts and the Deploy button share one row above the scroll
   container, so neither can scroll away on a short terminal; technical
   evidence lives behind a toggle. Compact viewports stack the two. */
#quick-deploy-summary {
    width: 100%;
    height: auto;
    padding: 1 2 1 2;
}

#quick-deploy-facts {
    width: 1fr;
    height: auto;
    padding: 0 1;
    color: $text;
    text-wrap: wrap;
    border: round $primary;
    border-title-color: $text;
    border-title-style: bold;
}

#quick-deploy-layout {
    width: 100%;
    height: 1fr;
    padding: 0 2 1 2;
}

#quick-deploy-profile-card,
#quick-deploy-form {
    height: auto;
    padding: 1 2;
    border: round $foreground 20%;
    background: $surface;
}

#quick-deploy-profile-card {
    width: 100%;
    margin: 0 0 1 0;
    /* Collapsed it holds one button; a bordered box around it read as an
       empty panel above the form. */
    border: none;
    padding: 0;
    background: transparent;
}

#quick-deploy-form {
    width: 100%;
    margin: 0 0 0 0;
}

#quick-deploy-form.-bare {
    border: none;
    padding: 0;
    background: transparent;
}

#quick-deploy-actions {
    width: 36;
    height: auto;
    padding: 0 0 0 2;
}

#quick-deploy-btn {
    width: 100%;
}

#quick-deploy-profile-title {
    color: $primary;
    padding: 0 0 1 0;
}

#quick-deploy-profile-body {
    color: $text;
    text-wrap: wrap;
    padding-top: 1;
}

#toggle-quick-details {
    width: auto;
}

.viewport-compact #quick-deploy-title,
.viewport-compact #quick-deploy-summary {
    padding-left: 1;
    padding-right: 1;
}

/* Below 120 columns the facts need the full width; Deploy and its hint take
   the row under them instead of a squeezed column beside them. */
.viewport-narrow #quick-deploy-summary {
    layout: vertical;
}

.viewport-narrow #quick-deploy-actions {
    width: 100%;
    height: auto;
    padding: 1 0 0 0;
    layout: horizontal;
}

.viewport-narrow #quick-deploy-btn {
    width: auto;
    min-width: 16;
}

.viewport-narrow #quick-deploy-feedback {
    width: 1fr;
    padding: 1 0 0 2;
}

.viewport-constrained #quick-deploy-actions {
    padding-top: 0;
}

#quick-deploy-feedback {
    height: auto;
    text-wrap: wrap;
}

#quick-fulfillment,
#quick-fulfillment-note {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

#quick-fulfillment-note {
    color: $text-muted;
}

/* ---- Deploy form ---- */

.form-label {
    color: $foreground;
    padding: 0 0 0 0;
    height: auto;
    text-wrap: wrap;
}

.form-hint {
    color: $text-muted;
    height: auto;
    text-wrap: wrap;
}

.form-section-subtitle {
    color: $text-muted;
    height: auto;
    text-wrap: wrap;
    padding: 0 0 1 0;
}

/* ---- Deploy form polish ---- */

LlamaCppDeployScreen .form-label,
VllmDeployScreen .form-label {
    color: $text;
    text-style: bold;
}

LlamaCppDeployScreen .form-hint,
VllmDeployScreen .form-hint,
LlamaCppDeployScreen .form-section-subtitle,
VllmDeployScreen .form-section-subtitle {
    color: $text-muted;
}

/* `$border` is the primary color, so every idle field used to wear the focus
   color and the focused one could not stand out. */
LlamaCppDeployScreen Input,
VllmDeployScreen Input {
    border: tall $foreground 25%;
}

LlamaCppDeployScreen Select > SelectCurrent,
VllmDeployScreen Select > SelectCurrent {
    border: tall $foreground 25%;
}

LlamaCppDeployScreen Input:focus,
VllmDeployScreen Input:focus {
    border: tall $primary;
    background: $surface-lighten-1;
}

LlamaCppDeployScreen Select:focus > SelectCurrent,
VllmDeployScreen Select:focus > SelectCurrent {
    border: tall $primary;
    background: $surface-lighten-1;
}

LlamaCppDeployScreen .gpu-config-panel,
VllmDeployScreen .gpu-config-panel {
    border: round $foreground 20%;
    background: $surface-lighten-1;
}

/* Section headings are separated from the field that follows them; bare
   label+control pairs otherwise collide with their neighbours because only
   FormField/ToggleField carry bottom padding. */
.form-group-heading {
    color: $text;
    text-style: bold;
    height: auto;
    text-wrap: wrap;
    padding: 1 0 1 0;
}

#vllm-vram-status {
    height: auto;
    text-wrap: wrap;
    padding: 0 0 1 0;
}

VisionOptions Select {
    margin-bottom: 1;
}

/* Offer status lines wrap to two rows on a narrow terminal; without a gap the
   second row butts against the GPU panel below. */
#prime-offer-status-llama,
#prime-offer-status,
#vast-offer-status-llama,
#vast-offer-status-vllm {
    height: auto;
    text-wrap: wrap;
    padding: 0 0 1 0;
}

/* The offer browser returns up to 100 rows, so it needs a real viewport. This
   lives here rather than in VastPreviewScreen.DEFAULT_CSS because the
   `DataTable { height: 1fr }` rule above comes from the app stylesheet and
   outranks a screen default, which collapsed the table to its 3-row minimum. */
#vast-offers {
    height: 14;
    margin-top: 1;
}

/* A provider offer dictates these, so they must read as reported values
   rather than as fields that merely happen to be filled in. */
LlamaCppDeployScreen Input:disabled,
VllmDeployScreen Input:disabled,
LlamaCppDeployScreen Select:disabled > SelectCurrent,
VllmDeployScreen Select:disabled > SelectCurrent {
    border: tall $panel;
    color: $text-muted;
    background: $surface;
}

/* ---- Monitor screen ---- */

#monitor-layout {
    height: 1fr;
}

#monitor-log-viewer {
    height: 1fr;
    min-height: 3;
}

.viewport-shallow #monitor-log-viewer {
    min-height: 2;
}

/* Short terminals: the log viewport keeps a floor instead of collapsing to
   zero under the progress panel and outcome card. */
.viewport-short #monitor-log-viewer {
    height: 1fr;
    min-height: 3;
}

#monitor-toolbar {
    width: 100%;
    height: 2;
    padding: 0 2;
    background: $surface;
    border-bottom: solid $foreground 15%;
}

#monitor-title {
    width: 1fr;
    height: 1;
    content-align: left middle;
}

#monitor-view-status {
    width: auto;
    height: 1;
    content-align: right middle;
    text-align: right;
}

#connection-card,
#result-card,
#failure-card {
    width: 100%;
    height: auto;
    max-height: 12;
    margin: 0 2 1 2;
    /* No vertical padding: a title, four fields, the action gap and a
       three-row button row fill ten rows, and the padding pushed the buttons'
       bottom edge past the cap into the card's own scroll. */
    padding: 0 2;
    border: round $primary;
    background: $surface-lighten-1;
}

#failure-card {
    border: round $error;
}

#connection-card-body,
#result-card-body,
#failure-card-body {
    height: auto;
    text-wrap: wrap;
}

#connection-card-actions,
#result-card-actions,
#failure-card-actions {
    width: 100%;
    height: auto;
    padding: 1 0 0 0;
}

#connection-card-actions Button,
#result-card-actions Button,
#failure-card-actions Button {
    margin: 0 1 0 0;
}

/* Persistent progress summary above the logs: one bordered panel, not nested
   chrome. The stage row is the widest line; hide it before the log viewport
   collapses on compact/short terminals (the title still names the active
   stage). The detail line hides only when height is truly scarce. */
DeploymentProgressWidget {
    margin: 0 2 1 2;
}

DeploymentProgressWidget #deploy-progress-title {
    color: $text;
    text-style: bold;
}

DeploymentProgressWidget #deploy-progress-hint {
    color: $text-muted;
}

.viewport-compact DeploymentProgressWidget #deploy-progress-stages,
.viewport-short DeploymentProgressWidget #deploy-progress-stages {
    display: none;
}

.viewport-short DeploymentProgressWidget #deploy-progress-detail {
    display: none;
}

.viewport-compact DeploymentProgressWidget,
.viewport-short DeploymentProgressWidget {
    margin: 0 1 1 1;
    padding: 0 1;
}

/* Rows are sized explicitly: left to the grid default, an auto-height grid
   gave each row two cells, so every button lost its label row and drew as an
   empty box. */
#connection-info-actions {
    width: 100%;
    height: auto;
    layout: grid;
    grid-size: 3;
    grid-rows: 3;
    grid-gutter: 1 1;
    margin: 1 0 0 0;
}

.viewport-minimal #connection-info-actions Button {
    margin: 0 0 1 0;
}

.viewport-narrow #connection-info-actions {
    layout: grid;
    grid-size: 2;
    grid-rows: 3;
}

.viewport-compact #connection-info-actions {
    layout: grid;
    grid-size: 2;
}

.viewport-narrow #connection-card-actions,
.viewport-narrow #failure-card-actions,
.viewport-narrow #result-card-actions {
    layout: grid;
    grid-size: 2;
    grid-rows: 3;
}

.viewport-minimal #connection-info-actions {
    layout: vertical;
}

/* Narrow cards stack their action buttons vertically; on a 12-row terminal
   five 3-row buttons alone overflow the viewport even inside a capped card.
   Two columns keep every action reachable by keyboard without scrolling the
   card off screen. This overrides the minimal vertical stacking above. */
.viewport-minimal #connection-card-actions,
.viewport-minimal #failure-card-actions,
.viewport-minimal #result-card-actions {
    layout: grid;
    grid-size: 2;
}

/* ---- Manage screen ---- */

#manage-layout {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#manage-title,
#manage-status,
#manage-selection-detail,
#stop-warning {
    height: auto;
}

#manage-status {
    margin: 0 0 1 0;
}

#manage-tabs {
    height: 1fr;
}

#manage-jobs DeploymentJobsPanel {
    height: 1fr;
}

#deployment-jobs {
    height: 1fr;
    min-height: 3;
}

#manage-endpoint-table {
    height: auto;
    min-height: 4;
    max-height: 12;
}

#manage-selection-detail {
    min-height: 2;
    margin: 1 0 0 0;
}

#manage-actions {
    width: 100%;
    height: auto;
    max-height: 8;
    margin: 1 0 0 0;
}

#manage-action-context {
    height: auto;
}

#stop-confirm-actions {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
}

#stop-confirm-actions Button {
    margin: 0 1 0 0;
}

/* ---- Settings screen ---- */

#setup-required-actions,
#connection-info-actions,
#delete-confirm-actions,
#result-card-actions {
    height: auto;
}

/* Save and feedback live in a persistent action bar below the scrolling form,
   so neither can end up below the fold on a short terminal. */
#settings-layout {
    width: 100%;
    height: 1fr;
}

#settings-scroll {
    height: 1fr;
}

#settings-actions {
    width: 100%;
    height: auto;
    padding: 0 2 1 2;
    background: $footer-background;
    border-top: solid $foreground 15%;
    align: left middle;
}

#settings-actions Button {
    margin-right: 2;
}

#save-feedback {
    width: 1fr;
    height: auto;
    content-align: left middle;
    text-wrap: wrap;
}

.viewport-compact #setup-required-actions,
.viewport-minimal #connection-info-actions {
    layout: vertical;
}

/* One action per authenticable provider, plus re-check and quit, has to fit a
   standard 80-column terminal before the compact rule stacks them. */
#setup-required-actions Button {
    min-width: 14;
}

/* Centering a child that is taller than the viewport pushes its head and tail
   off both ends at once, which is how Save and every save/discard message
   ended up permanently below the fold. Anchoring to the top keeps the form
   scrollable in the one direction that can reach them. */
#settings-scroll {
    align: center top;
}

#storage-layout,
#storage-scroll {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

/* VerticalScroll owns the screen scroll, so the table sizes itself against
   the viewport rather than the full content height; the responsive fit test
   holds non-scrolling widgets to the viewport. */
#storage-layout {
    min-height: 100%;
}

#storage-title,
#storage-status,
#storage-hint {
    height: auto;
    text-wrap: wrap;
}

#storage-status {
    margin: 0 0 1 0;
}

#storage-filter-row {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

#storage-provider-group {
    width: 3fr;
    height: auto;
    margin: 0 2 0 0;
}

#storage-backend-group {
    width: 2fr;
    height: auto;
}

#storage-provider-label {
    height: 1;
}

#storage-filter {
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
}

/* The inventory is the reason this screen exists, so it gets a real viewport
   rather than whatever `1fr` has left over once the filters above it have
   taken their share. */
#storage-table {
    height: 1fr;
    min-height: 9;
    max-height: 100%;
}

#storage-hint-row {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
}

#storage-hint {
    width: 1fr;
    height: auto;
    padding: 1 2 0 0;
}

#storage-predownload-toggle {
    width: auto;
}

.viewport-compact #storage-hint-row {
    layout: vertical;
}

.viewport-compact #storage-hint {
    padding: 0;
}

#storage-predownload-form {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
    padding: 1 2;
    border: round $foreground 20%;
    background: $surface;
}

.viewport-compact #storage-filter-row {
    layout: vertical;
}

.viewport-compact #storage-provider-group,
.viewport-compact #storage-backend-group {
    width: 100%;
    margin-right: 0;
}

#storage-empty {
    height: auto;
    padding: 1 1;
    border: round $foreground 20%;
    background: $surface;
    text-wrap: wrap;
}

/* A 60-column cap wrapped every hint onto a second line in a terminal with
   room to spare, and those wrapped lines are what pushed the form past the
   bottom of the screen. */
#settings-form {
    width: 100%;
    max-width: 88;
    height: auto;
    padding: 1 2;
    border: round $foreground 20%;
    background: $surface;
}

/* Section rhythm comes from margins rather than blank Static spacers, so the
   spacing is uniform and does not have to be re-counted when a field moves. */
.settings-section {
    height: 1;
    margin-top: 1;
    color: $text;
}

/* Fields carry their own bottom padding; the section margin on top of it
   opened a double gap before every heading that followed one. */
#settings-form FormField,
#settings-form ToggleField {
    padding-bottom: 0;
}

/* Direct children only. A hint nested inside a FormField cannot collapse its
   margin against the next heading's, so scoping this to the loose hints keeps
   every gap exactly one row. */
#settings-form > .form-hint {
    margin-bottom: 1;
}

#settings-appearance-row {
    width: 100%;
    height: auto;
}

.settings-appearance-control {
    width: 1fr;
    height: auto;
    margin-right: 2;
}

.settings-appearance-control:last-child {
    margin-right: 0;
}

#storage-predownload-actions {
    width: 100%;
    height: auto;
    margin-top: 1;
}

#storage-predownload-actions Static {
    width: auto;
    height: auto;
    margin: 1 0 0 1;
    color: $text-muted;
}

#save-feedback {
    height: auto;
    text-wrap: wrap;
}

/* Advanced deploy: model source and compute sit in labelled groups so the
   compute configuration is visible without scrolling past a tall picker. */
/* Each section names itself in its border, so no heading row (and no blank
   row above one) sits between the border and the first field. */
.deploy-group,
.gpu-config-panel {
    border-title-color: $primary;
    border-title-style: bold;
}

.deploy-group {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    border: round $foreground 20%;
    background: $surface;
}

#llama-deploy-actions,
#vllm-deploy-actions {
    width: 100%;
    height: auto;
    margin-top: 1;
    align: left middle;
}

#llama-deploy-actions Button,
#vllm-deploy-actions Button {
    margin-right: 2;
}

#llama-deploy-feedback,
#vllm-deploy-feedback {
    width: 1fr;
    height: auto;
    content-align: left middle;
    text-wrap: wrap;
}

.viewport-constrained .deploy-spacer {
    display: none;
}

.viewport-constrained .deploy-group {
    margin-bottom: 0;
}

/* ---- Deploy screen GPU row ---- */

#gpu-config-row-llama,
#gpu-config-row-vllm {
    width: 100%;
    height: auto;
}

.gpu-config-panel {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    border: round $foreground 20%;
    background: $surface;
}

.gpu-config-main-row {
    width: 100%;
    height: auto;
    padding: 0 0 1 0;
}

#gpu-type-group-llama,
#gpu-type-group-vllm {
    width: 2fr;
    height: auto;
    padding: 0 1 0 0;
}

#gpu-count-group-llama,
#gpu-count-group-vllm {
    width: 1fr;
    height: auto;
    padding: 0 0 0 1;
}

#gpu-count-llama,
#gpu-count-vllm {
    height: 3;
}

.gpu-config-tensor-field {
    padding: 0 0 1 0;
}

/* ---- Utility classes ---- */

.hidden {
    display: none;
}

.centered {
    text-align: center;
}

/* Height-constrained terminals (up to 24 rows): vertical economy without the
   aggressive hiding that .viewport-short applies. Decorative padding shrinks;
   search, tables and action bars keep their rows. */
.viewport-constrained #main-menu-primary,
.viewport-constrained .screen-scroll,
.viewport-constrained #fast-deploy-container,
.viewport-constrained #quick-deploy-layout,
.viewport-constrained #quick-deploy-summary {
    padding-top: 0;
    padding-bottom: 0;
}

.viewport-constrained .decorative-spacer {
    display: none;
}

.viewport-constrained #main-menu-primary {
    padding-top: 1;
    padding-bottom: 1;
}

/* The wordmark is pleasant on a tall terminal but displaces the menu at
   80x24; constrain its height rather than hiding it outright. */
.viewport-constrained #banner-text {
    padding-bottom: 0;
    max-height: 5;
    overflow-y: hidden;
}

/* The 80x24 home screen displaced its menu with the wordmark plus the
   four-line subtitle. Constrain both so navigation stays on screen. */
.viewport-constrained #main-menu-primary Static {
    margin-top: 0;
}

.viewport-constrained #fast-deploy-subtitle,
.viewport-constrained #fast-deploy-status,
.viewport-constrained #quick-deploy-subtitle {
    padding-bottom: 0;
}

.viewport-constrained #manage-status {
    margin-bottom: 0;
}

.viewport-constrained #manage-endpoint-table {
    min-height: 5;
    max-height: 100%;
}

.viewport-constrained #storage-table {
    min-height: 8;
    max-height: 100%;
}

.viewport-constrained #fast-deploy-list {
    max-height: 100%;
}

.viewport-constrained .form-group-heading {
    padding: 0;
}

.viewport-constrained #settings-form FormField,
.viewport-constrained #settings-form ToggleField {
    padding-bottom: 0;
}

.viewport-constrained #settings-form > .form-hint {
    margin-bottom: 0;
}

.viewport-constrained .settings-section {
    margin-top: 1;
}

.viewport-constrained #settings-appearance-row {
    margin-bottom: 0;
}

.viewport-constrained #fast-deploy-detail {
    min-height: 2;
    margin-top: 0;
}

/* ---- Responsive viewport profiles ---- */

#minimum-size-overlay {
    layer: overlay;
    dock: top;
    width: 100%;
    height: 100%;
    padding: 1;
    content-align: center middle;
    text-align: center;
    background: $background;
    color: $text;
}

StatusHeader.state-healthy,
StatusHeader.state-running {
    border-bottom: solid $success;
}

StatusHeader.state-queued,
StatusHeader.state-deploying,
StatusHeader.state-warming-up {
    border-bottom: solid $warning;
}

StatusHeader.state-error {
    border-bottom: solid $error;
}

#monitor-search {
    width: 100%;
    margin: 0;
}

.viewport-narrow #main-menu-side-column,
.viewport-short #main-menu-side-column {
    display: none;
}

/* The large wordmark is pleasant on an empty wide terminal, but at 80×24 it
   displaced four primary actions. The compact heading keeps the context while
   leaving the menu's complete first level visible. */
.viewport-narrow #banner-text,
.viewport-narrow .main-menu-version,
.viewport-narrow .decorative-spacer {
    display: none;
}

.viewport-narrow #compact-menu-header,
.viewport-narrow #compact-menu-help {
    display: block;
    width: 100%;
    height: auto;
    padding: 0 1;
}

.viewport-narrow #compact-menu-header {
    margin: 1 0 0 0;
}

.viewport-narrow #compact-menu-help {
    margin: 1 0 0 0;
}

.viewport-narrow.show-secondary-panel #main-menu-side-column,
.viewport-short.show-secondary-panel #main-menu-side-column {
    display: block;
    layer: overlay;
    dock: right;
    width: 80%;
    min-width: 40;
    max-width: 56;
    height: 100%;
    margin: 0;
    padding: 1;
    background: $background;
    border-left: solid $primary;
    overflow-y: auto;
    align-vertical: top;
}

.viewport-narrow #main-menu-layout {
    width: 100%;
    max-width: 100%;
}

.viewport-narrow #main-menu-primary {
    width: 100%;
}

.viewport-narrow #action-list {
    height: 8;
    min-height: 8;
    max-height: 8;
}

.viewport-narrow #auth-status-block {
    width: 100%;
    max-width: 100%;
    margin: 0 0 1 0;
}

/* Let it take a second line rather than stop mid-phrase; the narrow left
   column cut this to "... Vast.ai LLM" with no ellipsis to say so. */
.main-menu-version {
    height: auto;
    text-wrap: wrap;
}

.viewport-compact #banner-text,
.viewport-compact .main-menu-version,
.viewport-compact .decorative-spacer {
    display: none;
}

.viewport-compact #main-menu-center,
.viewport-compact #main-menu-layout,
.viewport-compact #main-menu-primary {
    height: auto;
    min-height: 0;
    content-align: left top;
    align: left top;
}

.viewport-compact #compact-menu-header,
.viewport-compact #compact-menu-help {
    display: block;
    width: 100%;
    height: auto;
    padding: 0 1;
}

.viewport-compact #compact-menu-header {
    margin: 1 0;
}

.viewport-compact #compact-menu-help {
    margin: 1 0 0 0;
}

.viewport-compact #action-list {
    height: 8;
    min-height: 8;
    max-height: 8;
}

.viewport-compact.viewport-short #action-list {
    height: 1fr;
    min-height: 3;
    max-height: 100%;
}

.viewport-compact.viewport-short #main-menu-center,
.viewport-compact.viewport-short #main-menu-layout,
.viewport-compact.viewport-short #main-menu-primary {
    height: 1fr;
}

.viewport-compact.viewport-short #compact-menu-header,
.viewport-compact.viewport-short #compact-menu-help {
    display: none;
}

.viewport-compact #main-menu-primary,
.viewport-compact .screen-scroll,
.viewport-compact #fast-deploy-container,
.viewport-compact #quick-deploy-layout,
.viewport-minimal #main-menu-primary,
.viewport-minimal .screen-scroll,
.viewport-minimal #fast-deploy-container,
.viewport-minimal #quick-deploy-layout,
.viewport-minimal #quick-deploy-summary {
    padding: 0;
}

.viewport-narrow #fast-deploy-subtitle,
.viewport-compact #fast-deploy-subtitle,
.viewport-short #fast-deploy-subtitle {
    display: none;
}

/* Search is the primary model control and stays visible at every supported
   size. The GPU filter keeps its label; only its surrounding chrome shrinks.
   The temporary search-open drawer is gone: hiding the box behind `/` also
   hid the `/` hint in the footer overflow, leaving no discoverable route. */
.viewport-narrow #fast-deploy-filter-row,
.viewport-compact #fast-deploy-filter-row {
    layout: vertical;
}

.viewport-narrow #fast-deploy-search-group,
.viewport-compact #fast-deploy-search-group {
    width: 100%;
    max-width: 100%;
    margin: 0 0 1 0;
}

.viewport-narrow #fast-deploy-gpu-group,
.viewport-minimal #fast-deploy-gpu-group,
.viewport-compact #fast-deploy-gpu-group {
    width: 100%;
    min-width: 0;
    margin: 0 0 1 0;
}

.viewport-compact #fast-deploy-gpu-filter {
    max-width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
}

.viewport-narrow #fast-deploy-model-search,
.viewport-compact #fast-deploy-model-search {
    height: 3;
    min-height: 3;
}


.viewport-compact #quick-deploy-profile-card,
.viewport-compact #quick-deploy-form,
.viewport-compact #settings-form {
    padding: 0 1;
}

/* At 52 columns the fulfillment select collapses to zero width; keep it in
   the focus chain but let the layout stack it below the details toggle. */
.viewport-compact #quick-deploy-form {
    layout: vertical;
}

.viewport-compact .gpu-config-main-row {
    layout: vertical;
}

.viewport-compact #settings-appearance-row {
    layout: vertical;
}

.viewport-compact .settings-appearance-control {
    width: 100%;
    margin-right: 0;
}

.viewport-compact #gpu-type-group-llama,
.viewport-compact #gpu-type-group-vllm,
.viewport-compact #gpu-count-group-llama,
.viewport-compact #gpu-count-group-vllm {
    width: 100%;
    padding: 0;
}

.viewport-compact #monitor-title,
.viewport-short #monitor-title {
    display: none;
}

.viewport-compact #monitor-view-status,
.viewport-short #monitor-view-status {
    width: 100%;
    text-align: left;
    content-align: left middle;
}

.viewport-short StatusHeader {
    padding: 0 1;
}

/* A short terminal has no rows to spare for a nine-row inventory; the header
   plus two rows still says what the screen is showing. */
.viewport-short #storage-table {
    min-height: 5;
}

.viewport-short #manage-selection-detail {
    display: none;
}

.viewport-short #monitor-toolbar {
    height: 1;
    padding: 0 1;
}

/* A completed deploy stacks a bordered outcome card (title, body, actions)
   above the log viewport. On constrained/short terminals that stack is
   taller than the terminal even with the toolbar/title collapsed, so the
   card scrolls internally at a capped height instead of pushing the log
   viewer off screen. The cap is rows, not percent: 65% of a 16-row terminal
   is still 10 rows for the card alone. */
.viewport-constrained #connection-card,
.viewport-constrained #result-card,
.viewport-constrained #failure-card,
.viewport-short #connection-card,
.viewport-short #result-card,
.viewport-short #failure-card {
    max-height: 4;
    margin: 0 1 0 1;
    padding: 0 1;
    overflow-y: auto;
}

/* Narrow cards stack their action buttons vertically; on a 12-row terminal
   five 3-row buttons alone overflow the viewport even inside a capped card.
   Two columns keep Copy URL / Copy key / Copy all reachable by keyboard
   without scrolling the card off screen.
.viewport-minimal #connection-card-actions,
.viewport-minimal #result-card-actions,
.viewport-minimal #failure-card-actions {
    layout: grid;
    grid-size: 2;
} */

/* At 40x12 every row is spent: header (2) + toolbar (1) + progress (4) +
   card (4) already fill the terminal before the log viewer or footer. Hide
   the progress detail/hint rows there; the title still names the state. */
.viewport-shallow DeploymentProgressWidget #deploy-progress-detail {
    display: none;
}

.viewport-shallow DeploymentProgressWidget #deploy-progress-hint {
    display: none;
}

.viewport-constrained DeploymentProgressWidget,
.viewport-short DeploymentProgressWidget {
    margin: 0 1 0 1;
    padding: 0 1;
}

.viewport-short .form-hint,
.viewport-short .form-section-subtitle,
.viewport-short #quick-deploy-subtitle,
.viewport-short #storage-hint {
    display: none;
}

.viewport-short #fast-deploy-subtitle,
.viewport-short #fast-deploy-gpu-label,
.viewport-short #fast-deploy-search-label,
.viewport-short #fast-deploy-detail {
    display: none;
}

.viewport-short #auth-status-block {
    max-height: 4;
    overflow-y: auto;
}

.viewport-short #quick-deploy-profile-card {
    max-height: 9;
    overflow-y: auto;
}

/* Width alone never hides content: a phone in portrait is under 60 columns
   but has plenty of rows, and these rules used to leave it one model row, no
   detail, no status and no footer above thirty empty lines. The vertical
   economies below apply only when the terminal is also short. */
.viewport-minimal.viewport-short Footer,
.viewport-shallow Footer {
    display: none;
}

.viewport-shallow #connection-card {
    padding: 0 1;
    margin: 0 1 0 1;
}

.viewport-shallow #connection-card-actions {
    padding: 0;
}

.viewport-minimal #quick-deploy-profile-card,
.viewport-minimal #quick-deploy-form,
.viewport-minimal #settings-form,
.viewport-minimal LogViewer,
.viewport-minimal DataTable,
.viewport-minimal OptionList {
    border-left: none;
    border-right: none;
}

/* At the 40x12 floor the chrome (title, filters, status, footer) already
   spends the viewport; the scrolling list and detail shrink to their minimum
   rather than overflowing it. */
.viewport-minimal #fast-deploy-filter-row {
    margin: 0;
}

.viewport-minimal #fast-deploy-search-group,
.viewport-minimal #fast-deploy-gpu-group {
    margin-bottom: 0;
}

.viewport-minimal.viewport-short #fast-deploy-status {
    display: none;
}

.viewport-minimal.viewport-short #fast-deploy-detail {
    display: none;
}

.viewport-minimal.viewport-short #fast-deploy-list {
    min-height: 3;
    max-height: 3;
}

.viewport-minimal.viewport-short #quick-deploy-facts {
    /* The border keeps the model name; two fact lines fit inside it. */
    max-height: 4;
    overflow-y: hidden;
}

/* At the 40x12 floor only the facts and Deploy survive: the key hint hides
   rather than overflowing the viewport. The scrollable card keeps its place
   in the focus chain -- hiding it would strand arrow-key users on Deploy. */
.viewport-minimal.viewport-short #quick-deploy-feedback {
    display: none;
}

.viewport-minimal #quick-deploy-summary {
    padding: 0 1;
}

.viewport-minimal #storage-predownload-actions {
    layout: vertical;
}

.viewport-minimal #storage-predownload-actions Static {
    width: 100%;
    margin: 0;
}

.density-compact .screen-scroll,
.density-compact #main-menu-primary,
.density-compact #fast-deploy-container,
.density-compact #quick-deploy-layout,
.density-compact #quick-deploy-profile-card,
.density-compact #quick-deploy-form,
.density-compact #quick-deploy-summary,
.density-compact #settings-form {
    padding-top: 0;
    padding-bottom: 0;
}

CopyEnabledScreen.viewport-ultra-wide {
    align-horizontal: center;
}

.viewport-ultra-wide .screen-scroll,
.viewport-ultra-wide #fast-deploy-container,
.viewport-ultra-wide #quick-deploy-layout,
.viewport-ultra-wide #quick-deploy-summary {
    max-width: 160;
}

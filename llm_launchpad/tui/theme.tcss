/* ==========================================================
   llm-launchpad Textual theme
   Modal-inspired: deep black surfaces, vivid green accents,
   restrained chrome, and high-contrast content areas.
   ========================================================== */

/* ---- Global ---- */

Screen {
    background: #050806;
    color: #eef7ef;
}

/* ---- Header / Footer bars ---- */

#header-bar {
    dock: top;
    height: 3;
    background: #070b08;
    color: #eef7ef;
    padding: 0 2;
    border-bottom: solid #7bf168;
}

#header-bar .app-title {
    text-style: bold;
    color: #7bf168;
}

#header-bar .app-meta {
    color: #93a596;
}

#footer-bar {
    dock: bottom;
    height: 1;
    background: #070b08;
    color: #93a596;
    padding: 0 2;
}

Footer {
    height: 2;
    background: #070b08;
    color: #93a596;
    border-top: solid #17321e;
}

/* ---- Status header widget ---- */

StatusHeader {
    height: 4;
    padding: 0 2;
    background: #070b08;
    border-bottom: solid #17321e;
}

StatusHeader .status-label {
    text-style: bold;
    color: #7bf168;
}

StatusHeader .status-value {
    color: #eef7ef;
}

/* ---- Log viewer ---- */

LogViewer {
    height: 1fr;
    border: solid #17321e;
    background: #0a0f0b;
    padding: 0 1;
}

LogViewer Log {
    scrollbar-size: 1 1;
}

/* ---- Main menu ---- */

#main-menu {
    align: center middle;
    width: 100%;
    height: 100%;
}

#menu-container {
    width: 1fr;
    min-width: 56;
    height: auto;
    padding: 1 2;
}

#main-menu-layout {
    width: 100%;
    max-width: 126;
    height: auto;
}

#main-menu-side-column {
    width: 50;
    min-width: 38;
    height: auto;
    margin: 1 0 0 1;
}

#deployment-status-panel {
    width: 100%;
    height: auto;
    padding: 0 2;
    border: solid #17321e;
    background: #0b110d;
}

#billing-report-panel {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 2;
    border: solid #17321e;
    background: #0b110d;
}

#quick-deploy-panel {
    width: 100%;
    height: auto;
    min-height: 11;
    margin: 1 0 0 0;
    padding: 0 2;
    border: solid #2b5933;
    background: #0f1812;
}

#deployment-status-title {
    padding: 0 0 0 0;
}

#deployment-status-body {
    color: #eef7ef;
    text-wrap: wrap;
}

#billing-report-title {
    padding: 0 0 0 0;
}

#billing-report-body {
    color: #eef7ef;
    text-wrap: wrap;
}

#landing-quick-deploy-title {
    padding: 0 0 0 0;
}

#landing-quick-deploy-subtitle {
    color: #b7c9b9;
    text-style: bold;
    padding: 0 0 0 0;
}

#landing-quick-deploy-helper {
    color: #93a596;
    padding: 1 0 0 0;
}

#quick-deploy-list {
    border: solid #2b5933;
    background: #0b110d;
    max-height: 10;
}

#quick-deploy-list:focus {
    border: solid #7bf168;
}

#banner-text {
    text-align: center;
    color: #7bf168;
    padding: 0 0 1 0;
}

#auth-status-block {
    dock: bottom;
    width: auto;
    max-width: 92;
    height: auto;
    min-height: 4;
    margin: 0 0 1 1;
    padding: 0 1;
    border-left: tall #17321e;
    color: #93a596;
    background: transparent;
}

/* ---- Option / Selection Lists ---- */

OptionList {
    background: #0b110d;
    border: solid #17321e;
    padding: 0;
    height: auto;
    max-height: 20;
}

OptionList:focus {
    border: solid #7bf168;
}

OptionList > .option-list--option-highlighted {
    background: #12311b;
    color: #eef7ef;
    text-style: bold;
}

OptionList > .option-list--option-hover-highlighted {
    background: #12311b;
    color: #eef7ef;
    text-style: bold;
}

DataTable {
    background: #0b110d;
    border: solid #17321e;
    height: 20;
    color: #eef7ef;
}

DataTable:focus {
    border: solid #7bf168;
}

SelectionList {
    background: #0b110d;
    height: auto;
    max-height: 20;
}

ListView {
    background: #0b110d;
    height: auto;
    max-height: 20;
}

ListView > ListItem.--highlight {
    background: #12311b;
}

/* ---- Inputs ---- */

Input {
    border: tall #1d3c25;
    background: #0b110d;
    color: #eef7ef;
    padding: 0 1;
}

Input:focus {
    border: tall #7bf168;
    background: #0f1812;
}

Select {
    border: tall #1d3c25;
    background: #0b110d;
    color: #eef7ef;
}

Select:focus {
    border: tall #7bf168;
    background: #0f1812;
}

Switch {
    background: #0b110d;
}

Switch > .switch--slider {
    color: #050806;
    background: #2d3b30;
}

Switch.-on > .switch--slider {
    background: #7bf168;
}

/* ---- Buttons ---- */

Button {
    min-width: 16;
    background: #101913;
    color: #eef7ef;
    border: solid #17321e;
}

Button:hover {
    background: #12311b;
    border: solid #7bf168;
}

Button.-primary {
    background: #7bf168;
    color: #050806;
    text-style: bold;
    border: solid #7bf168;
}

Button:focus {
    text-style: bold;
    border: solid #95ff85;
}

/* ---- Quick deploy screen ---- */

#quick-deploy-title {
    padding: 1 2 0 2;
}

#quick-deploy-subtitle {
    padding: 0 2 0 2;
    color: #93a596;
}

#quick-deploy-layout {
    width: 100%;
    height: auto;
    padding: 0 2 1 2;
}

#quick-deploy-profile-card,
#quick-deploy-form {
    height: auto;
    padding: 1 2;
    border: solid #17321e;
    background: #0b110d;
}

#quick-deploy-profile-card {
    width: 100%;
    margin: 0 0 1 0;
}

#quick-deploy-form {
    width: 100%;
    margin: 0 0 0 0;
}

#quick-deploy-profile-title {
    color: #7bf168;
    padding: 0 0 1 0;
}

#quick-deploy-profile-body {
    color: #eef7ef;
    text-wrap: wrap;
}

#quick-deploy-feedback {
    height: 1;
}

/* ---- Dialogs / Modals ---- */

#dialog-overlay {
    align: center middle;
    background: #050806 82%;
}

#dialog-box {
    width: 60;
    height: auto;
    max-height: 70%;
    padding: 1 2;
    border: solid #7bf168;
    background: #0b110d;
}

/* ---- Deploy form ---- */

.form-group {
    height: auto;
    padding: 0 0 1 0;
}

.form-label {
    color: #c8d6c9;
    padding: 0 0 0 0;
    height: 1;
}

.form-hint {
    color: #7f9082;
    height: 1;
}

.form-section-title {
    color: #7bf168;
    text-style: bold;
    height: 1;
}

.form-section-subtitle {
    color: #7f9082;
    height: 1;
    padding: 0 0 1 0;
}

/* ---- Deploy form polish ---- */

LlamaCppDeployScreen .form-label,
VllmDeployScreen .form-label {
    color: #eef7ef;
    text-style: bold;
}

LlamaCppDeployScreen .form-hint,
VllmDeployScreen .form-hint,
LlamaCppDeployScreen .form-section-subtitle,
VllmDeployScreen .form-section-subtitle {
    color: #93a596;
}

LlamaCppDeployScreen Input,
VllmDeployScreen Input,
LlamaCppDeployScreen Select,
VllmDeployScreen Select {
    border: tall #2b5933;
}

LlamaCppDeployScreen Input:focus,
VllmDeployScreen Input:focus,
LlamaCppDeployScreen Select:focus,
VllmDeployScreen Select:focus {
    border: tall #7bf168;
    background: #0f1812;
}

LlamaCppDeployScreen .gpu-config-panel,
VllmDeployScreen .gpu-config-panel {
    border: tall #2b5933;
    background: #0f1812;
}

/* ---- Monitor screen ---- */

#monitor-layout {
    height: 100%;
}

#monitor-log {
    height: 1fr;
    border: solid #17321e;
    padding: 0 1;
}

#monitor-status {
    dock: top;
    height: 3;
    padding: 0 2;
    background: #070b08;
    border-bottom: solid #17321e;
}

/* ---- Manage screen ---- */

#manage-layout {
    height: 100%;
    padding: 1 2;
}

/* ---- Settings screen ---- */

#settings-layout {
    align: center middle;
    width: 100%;
    height: 100%;
}

#settings-form {
    width: 60;
    height: auto;
    padding: 1 2;
    border: solid #17321e;
    background: #0b110d;
}

/* ---- Deploy screen GPU row ---- */

#gpu-config-row-llama,
#gpu-config-row-vllm {
    width: 100%;
    height: auto;
}

.gpu-config-panel {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1 1 1;
    border: tall #1d3c25;
    background: #0b110d;
}

.gpu-config-main-row {
    width: 100%;
    height: auto;
    padding: 0 0 1 0;
}

#gpu-type-group-llama,
#gpu-type-group-vllm {
    width: 2fr;
    height: auto;
    padding: 0 1 0 0;
}

#gpu-count-group-llama,
#gpu-count-group-vllm {
    width: 1fr;
    height: auto;
    padding: 0 0 0 1;
}

#gpu-count-llama,
#gpu-count-vllm {
    height: 3;
}

.gpu-config-tensor-field {
    padding: 0;
}

/* ---- Utility classes ---- */

.hidden {
    display: none;
}

.centered {
    text-align: center;
}

.bold {
    text-style: bold;
}

.accent {
    color: #7bf168;
}

.muted {
    color: #93a596;
}

.spacer {
    height: 1;
}

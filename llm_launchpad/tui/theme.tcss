/* ==========================================================
   llm-launchpad Textual theme
   Modal-inspired: deep black surfaces, vivid green accents,
   restrained chrome, and high-contrast content areas.
   ========================================================== */

/* ---- Global ---- */

* {
    scrollbar-background: $scrollbar-background;
    scrollbar-color: $scrollbar;
    scrollbar-background-hover: $scrollbar-background-hover;
    scrollbar-color-hover: $scrollbar-hover;
    scrollbar-background-active: $scrollbar-background-active;
    scrollbar-color-active: $scrollbar-active;
    scrollbar-size: 1 1;
    scrollbar-gutter: stable;
}

Screen {
    background: $background;
    color: $text;
}

Vertical,
VerticalScroll,
OptionList,
DataTable,
SelectionList,
ListView {
    scrollbar-background: $scrollbar-background;
    scrollbar-color: $scrollbar;
    scrollbar-background-hover: $scrollbar-background-hover;
    scrollbar-color-hover: $scrollbar-hover;
    scrollbar-background-active: $scrollbar-background-active;
    scrollbar-color-active: $scrollbar-active;
}

/* ---- Footer ---- */

Footer {
    height: 2;
    background: $footer-background;
    color: $footer-foreground;
    border-top: solid $border;
}

/* ---- Status header widget ---- */

StatusHeader {
    height: 4;
    padding: 0 2;
    background: $surface;
    border-bottom: solid $border;
}

/* ---- Log viewer ---- */

LogViewer {
    height: 1fr;
    border: solid $border;
    background: $surface;
    padding: 0 1;
}

LogViewer Log {
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

/* ---- Main menu ---- */

#main-menu-center {
    height: 1fr;
}

#compact-menu-header,
#compact-menu-help {
    display: none;
}

#main-menu-primary {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    content-align: center middle;
    align: center middle;
}

.screen-scroll {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

#main-menu-layout {
    width: 100%;
    max-width: 126;
    height: 1fr;
    max-height: 100%;
}

#main-menu-side-column {
    width: 56;
    min-width: 42;
    height: 1fr;
    max-height: 100%;
    margin: 1 0 0 1;
    overflow-y: auto;
}

#deployment-status-panel {
    width: 100%;
    height: auto;
    max-height: 14;
    overflow-y: auto;
    padding: 0 2;
    border: solid $border;
    background: $panel;
}

#billing-report-panel {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 2;
    border: solid $border;
    background: $panel;
}

#deployment-status-title {
    padding: 0 0 0 0;
}

#deployment-status-body {
    color: $text;
    text-wrap: wrap;
    overflow-y: auto;
}

#billing-report-title {
    padding: 0 0 0 0;
}

#billing-report-body {
    color: $text;
    text-wrap: wrap;
}

#banner-text {
    text-align: center;
    color: $primary;
    padding: 0 0 1 0;
}

#auth-status-block {
    width: auto;
    max-width: 92;
    height: auto;
    min-height: 4;
    margin: 0 0 1 1;
    padding: 0 1;
    border-left: tall $border;
    color: $text-muted;
    background: transparent;
}

/* ---- Option / Selection Lists ---- */

OptionList {
    background: $surface;
    border: solid $border;
    padding: 0;
    height: auto;
    max-height: 20;
}

OptionList:focus {
    border: solid $primary;
}

OptionList > .option-list--option-highlighted {
    background: $primary-background;
    color: $text;
    text-style: bold;
}

OptionList > .option-list--option-hover-highlighted {
    background: $primary-background;
    color: $text;
    text-style: bold;
}

DataTable {
    background: $surface;
    border: solid $border;
    height: 1fr;
    min-height: 3;
    max-height: 20;
    color: $text;
}

DataTable:focus {
    border: solid $primary;
}

SelectionList {
    background: $surface;
    height: auto;
    max-height: 20;
}

ListView {
    background: $surface;
    height: auto;
    max-height: 20;
}

ListView > ListItem.--highlight {
    background: $primary-background;
}

/* ---- Inputs ---- */

Input {
    border: tall $border;
    background: $surface;
    color: $text;
    padding: 0 1;
}

Input:focus {
    border: tall $primary;
    background: $surface-lighten-1;
}

/* Textual's Select already draws a border around its value row (SelectCurrent).
   Bordering the Select itself nests one box inside another, so the border is
   styled where the widget actually draws it. */
Select {
    border: none;
    background: $surface;
    color: $text;
}

Select > SelectCurrent {
    border: tall $border;
}

Select:focus > SelectCurrent {
    border: tall $primary;
    background: $surface-lighten-1;
}

Switch {
    background: $surface;
}

Switch > .switch--slider {
    color: $background;
    background: $foreground-muted;
}

Switch.-on > .switch--slider {
    background: $primary;
}

/* ---- Buttons ---- */

Button {
    min-width: 16;
    background: $panel;
    color: $text;
    border: solid $border;
}

Button:hover {
    background: $primary-background;
    border: solid $primary;
}

Button.-primary {
    background: $primary;
    color: $button-color-foreground;
    text-style: bold;
    border: solid $primary;
}

Button:focus {
    text-style: bold;
    border: solid $accent;
}

/* ---- Fast deploy flow ---- */

#fast-deploy-container {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

#fast-deploy-title {
    height: auto;
}

#fast-deploy-subtitle,
#fast-deploy-status {
    color: $text-muted;
    height: auto;
    padding: 0 0 1 0;
}

#fast-deploy-gpu-label {
    color: $text-muted;
    height: 1;
    padding: 0;
    margin: 0;
}

#fast-deploy-filter-row {
    width: 100%;
    height: auto;
}

#fast-deploy-gpu-filter {
    width: 1fr;
    max-width: 36;
    /* Select draws its own bordered value row; pinning the outer height
       squeezes that border into the line the value should occupy. */
    height: auto;
    margin: 0 1 1 0;
    padding: 0;
}

#fast-deploy-model-search {
    width: 1fr;
    max-width: 36;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0;
}

#fast-deploy-list {
    width: 100%;
    height: 1fr;
    max-height: 24;
    text-wrap: nowrap;
}

#fast-deploy-list > .option-list--option {
    text-wrap: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
}

#fast-deploy-detail {
    width: 100%;
    height: auto;
    min-height: 3;
    margin: 1 0 0 0;
    padding: 0 1;
    border-left: tall $primary;
    background: $surface-lighten-1;
    text-wrap: wrap;
}

/* ---- Quick deploy screen ---- */

#quick-deploy-title {
    padding: 1 2 0 2;
}

#quick-deploy-subtitle {
    padding: 0 2 0 2;
    color: $text-muted;
}

#quick-deploy-layout {
    width: 100%;
    height: 1fr;
    padding: 0 2 1 2;
}

#quick-deploy-profile-card,
#quick-deploy-form {
    height: auto;
    padding: 1 2;
    border: solid $border;
    background: $surface;
}

#quick-deploy-profile-card {
    width: 100%;
    margin: 0 0 1 0;
}

#quick-deploy-form {
    width: 100%;
    margin: 0 0 0 0;
}

#quick-deploy-actions {
    width: 100%;
    height: auto;
    padding: 0 2 1 2;
}

#quick-deploy-profile-title {
    color: $primary;
    padding: 0 0 1 0;
}

#quick-deploy-profile-body {
    color: $text;
    text-wrap: wrap;
}

#quick-deploy-feedback {
    height: 1;
}

#quick-fulfillment,
#quick-fulfillment-note {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

#quick-fulfillment-note {
    color: $text-muted;
}

/* ---- Deploy form ---- */

.form-label {
    color: $foreground;
    padding: 0 0 0 0;
    height: auto;
    text-wrap: wrap;
}

.form-hint {
    color: $text-muted;
    height: auto;
    text-wrap: wrap;
}

.form-section-title {
    color: $primary;
    text-style: bold;
    height: auto;
    text-wrap: wrap;
}

.form-section-subtitle {
    color: $text-muted;
    height: auto;
    text-wrap: wrap;
    padding: 0 0 1 0;
}

/* ---- Deploy form polish ---- */

LlamaCppDeployScreen .form-label,
VllmDeployScreen .form-label {
    color: $text;
    text-style: bold;
}

LlamaCppDeployScreen .form-hint,
VllmDeployScreen .form-hint,
LlamaCppDeployScreen .form-section-subtitle,
VllmDeployScreen .form-section-subtitle {
    color: $text-muted;
}

LlamaCppDeployScreen Input,
VllmDeployScreen Input {
    border: tall $border;
}

LlamaCppDeployScreen Select > SelectCurrent,
VllmDeployScreen Select > SelectCurrent {
    border: tall $border;
}

LlamaCppDeployScreen Input:focus,
VllmDeployScreen Input:focus {
    border: tall $primary;
    background: $surface-lighten-1;
}

LlamaCppDeployScreen Select:focus > SelectCurrent,
VllmDeployScreen Select:focus > SelectCurrent {
    border: tall $primary;
    background: $surface-lighten-1;
}

LlamaCppDeployScreen .gpu-config-panel,
VllmDeployScreen .gpu-config-panel {
    border: tall $border;
    background: $surface-lighten-1;
}

/* ---- Monitor screen ---- */

#monitor-layout {
    height: 1fr;
}

#monitor-toolbar {
    width: 100%;
    height: 2;
    padding: 0 2;
    background: $surface;
    border-bottom: solid $border;
}

#monitor-title {
    width: 1fr;
    height: 1;
    content-align: left middle;
}

#monitor-view-status {
    width: auto;
    height: 1;
    content-align: right middle;
    text-align: right;
}

#connection-card {
    width: 100%;
    height: auto;
    margin: 0 2 1 2;
    padding: 1 2;
    border: solid $primary;
    background: $surface-lighten-1;
}

#connection-card-body {
    height: auto;
    text-wrap: wrap;
}

#connection-card-actions {
    width: 100%;
    height: auto;
    padding: 1 0 0 0;
}

#connection-card-actions Button {
    margin: 0 1 0 0;
}

/* ---- Manage screen ---- */

#manage-layout {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#manage-title,
#manage-status,
#manage-selection-detail,
#manage-help,
#stop-warning {
    height: auto;
}

#manage-status {
    margin: 0 0 1 0;
}

#manage-endpoint-table {
    height: auto;
    min-height: 4;
    max-height: 12;
}

#manage-selection-detail {
    min-height: 2;
    margin: 1 0 0 0;
}

#manage-actions {
    width: 100%;
    height: auto;
    max-height: 8;
    margin: 1 0 0 0;
}

#manage-action-context,
#manage-action-help {
    height: auto;
}

#manage-action-help {
    margin: 1 0 0 0;
}

#stop-confirm-actions {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
}

#stop-confirm-actions Button {
    margin: 0 1 0 0;
}

/* ---- Settings screen ---- */

#settings-scroll {
    align: center middle;
}

#storage-controls {
    height: auto;
}

#settings-form {
    width: 100%;
    max-width: 60;
    height: auto;
    padding: 1 2;
    border: solid $border;
    background: $surface;
}

/* ---- Deploy screen GPU row ---- */

#gpu-config-row-llama,
#gpu-config-row-vllm {
    width: 100%;
    height: auto;
}

.gpu-config-panel {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1 1 1;
    border: tall $border;
    background: $surface;
}

.gpu-config-main-row {
    width: 100%;
    height: auto;
    padding: 0 0 1 0;
}

#gpu-type-group-llama,
#gpu-type-group-vllm {
    width: 2fr;
    height: auto;
    padding: 0 1 0 0;
}

#gpu-count-group-llama,
#gpu-count-group-vllm {
    width: 1fr;
    height: auto;
    padding: 0 0 0 1;
}

#gpu-count-llama,
#gpu-count-vllm {
    height: 3;
}

.gpu-config-tensor-field {
    padding: 0;
}

/* ---- Utility classes ---- */

.hidden {
    display: none;
}

.centered {
    text-align: center;
}

/* ---- Responsive viewport profiles ---- */

#minimum-size-overlay {
    layer: overlay;
    dock: top;
    width: 100%;
    height: 100%;
    padding: 1;
    content-align: center middle;
    text-align: center;
    background: $background;
    color: $text;
}

StatusHeader.state-healthy,
StatusHeader.state-running {
    border-bottom: solid $success;
}

StatusHeader.state-queued,
StatusHeader.state-deploying,
StatusHeader.state-warming-up {
    border-bottom: solid $warning;
}

#monitor-search {
    width: 100%;
    margin: 0;
}

.viewport-narrow #main-menu-side-column,
.viewport-short #main-menu-side-column {
    display: none;
}

.viewport-narrow.show-secondary-panel #main-menu-side-column,
.viewport-short.show-secondary-panel #main-menu-side-column {
    display: block;
    layer: overlay;
    dock: right;
    width: 80%;
    min-width: 40;
    max-width: 56;
    height: 100%;
    margin: 0;
    padding: 1;
    background: $background;
    border-left: solid $primary;
    overflow-y: auto;
}

.viewport-narrow #main-menu-layout {
    width: 100%;
    max-width: 100%;
}

.viewport-narrow #main-menu-primary {
    width: 100%;
}

.viewport-narrow #auth-status-block {
    width: 100%;
    max-width: 100%;
    margin: 0 0 1 0;
}

.viewport-compact #banner-text,
.viewport-compact .main-menu-version,
.viewport-compact .decorative-spacer {
    display: none;
}

.viewport-compact #main-menu-center,
.viewport-compact #main-menu-layout,
.viewport-compact #main-menu-primary {
    height: auto;
    min-height: 0;
    content-align: left top;
    align: left top;
}

.viewport-compact #compact-menu-header,
.viewport-compact #compact-menu-help {
    display: block;
    width: 100%;
    height: auto;
    padding: 0 1;
}

.viewport-compact #compact-menu-header {
    margin: 1 0;
}

.viewport-compact #compact-menu-help {
    margin: 1 0 0 0;
}

.viewport-compact #action-list {
    height: 7;
    min-height: 7;
    max-height: 7;
}

.viewport-compact.viewport-short #action-list {
    height: 1fr;
    min-height: 3;
    max-height: 100%;
}

.viewport-compact.viewport-short #main-menu-center,
.viewport-compact.viewport-short #main-menu-layout,
.viewport-compact.viewport-short #main-menu-primary {
    height: 1fr;
}

.viewport-compact.viewport-short #compact-menu-header,
.viewport-compact.viewport-short #compact-menu-help {
    display: none;
}

.viewport-compact #main-menu-primary,
.viewport-compact .screen-scroll,
.viewport-compact #fast-deploy-container,
.viewport-compact #quick-deploy-layout,
.viewport-compact #quick-deploy-actions {
    padding: 0 1;
}

.viewport-minimal #main-menu-primary,
.viewport-minimal .screen-scroll,
.viewport-minimal #fast-deploy-container,
.viewport-minimal #quick-deploy-layout,
.viewport-minimal #quick-deploy-actions {
    padding: 0;
}

.viewport-narrow #fast-deploy-subtitle,
.viewport-narrow #fast-deploy-gpu-label,
.viewport-narrow #fast-deploy-model-search,
.viewport-compact #fast-deploy-subtitle,
.viewport-compact #fast-deploy-gpu-label,
.viewport-minimal #fast-deploy-model-search,
.viewport-short #fast-deploy-model-search {
    display: none;
}

.viewport-narrow #fast-deploy-gpu-filter,
.viewport-minimal #fast-deploy-gpu-filter {
    max-width: 100%;
    margin-right: 0;
}

.viewport-compact #fast-deploy-gpu-filter {
    max-width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
}

.viewport-compact #quick-deploy-title,
.viewport-compact #quick-deploy-subtitle {
    padding-left: 1;
    padding-right: 1;
}

.viewport-compact #quick-deploy-profile-card,
.viewport-compact #quick-deploy-form,
.viewport-compact #quick-deploy-actions,
.viewport-compact #settings-form {
    padding: 0 1;
}

.viewport-compact .gpu-config-main-row {
    layout: vertical;
}

.viewport-compact #gpu-type-group-llama,
.viewport-compact #gpu-type-group-vllm,
.viewport-compact #gpu-count-group-llama,
.viewport-compact #gpu-count-group-vllm {
    width: 100%;
    padding: 0;
}

.viewport-compact #monitor-title,
.viewport-short #monitor-title {
    display: none;
}

.viewport-compact #monitor-view-status,
.viewport-short #monitor-view-status {
    width: 100%;
    text-align: left;
    content-align: left middle;
}

.viewport-short StatusHeader {
    height: 2;
    padding: 0 1;
}

.viewport-short #manage-selection-detail,
.viewport-short #manage-help {
    display: none;
}

.viewport-short #monitor-toolbar {
    height: 1;
    padding: 0 1;
}

.viewport-short .form-hint,
.viewport-short .form-section-subtitle,
.viewport-short #quick-deploy-subtitle,
.viewport-short #storage-hint {
    display: none;
}

.viewport-short #fast-deploy-subtitle,
.viewport-short #fast-deploy-gpu-label,
.viewport-short #fast-deploy-detail {
    display: none;
}

.viewport-short #auth-status-block {
    max-height: 4;
    overflow-y: auto;
}

.viewport-minimal Footer,
.viewport-shallow Footer {
    display: none;
}

.viewport-shallow #connection-card {
    padding: 0 1;
    margin: 0;
}

.viewport-shallow #connection-card-actions {
    padding: 0;
}

.viewport-minimal #quick-deploy-profile-card,
.viewport-minimal #quick-deploy-form,
.viewport-minimal #settings-form,
.viewport-minimal LogViewer,
.viewport-minimal DataTable,
.viewport-minimal OptionList {
    border-left: none;
    border-right: none;
}

.density-compact .screen-scroll,
.density-compact #main-menu-primary,
.density-compact #fast-deploy-container,
.density-compact #quick-deploy-layout,
.density-compact #quick-deploy-profile-card,
.density-compact #quick-deploy-form,
.density-compact #quick-deploy-actions,
.density-compact #settings-form {
    padding-top: 0;
    padding-bottom: 0;
}

CopyEnabledScreen.viewport-ultra-wide {
    align-horizontal: center;
}

.viewport-ultra-wide .screen-scroll,
.viewport-ultra-wide #fast-deploy-container,
.viewport-ultra-wide #quick-deploy-layout,
.viewport-ultra-wide #quick-deploy-actions {
    max-width: 160;
}
